{
  "name": "mapbox-vector-tiles-chrome-extension",
  "displayName": "Mapbox Vector Tiles (Forked)",
  "version": "2.3.0",
  "contributors": [
    {
      "name": "Leonid Gorshkov",
      "email": "gorshkov.leonid@gmail.com",
      "url": "https://github.com/gorshkov-leonid"
    },
    {
      "name": "Ramon Bouckaert",
      "email": "ramon@bouckaert.com.au",
      "url": "https://github.com/ramonbouckaert"
    }
  ],
  "description": "Parser for loaded Mapbox Vector Tiles",
  "type": "module",
  "private": true,
  "license": "MIT",
  "keywords": [
    "chrome-extension",
    "developer-tools",
    "mvt",
    "mapbox-vector-tiles"
  ],
  "engines": {
    "node": ">=25.7.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.node.json && vite build",
    "test": "node --test \"test/**/*.test.ts\"",
    "preview": "vite preview",
    "fmt": "prettier --write '**/*.{ts,json,css,scss,md,html}'",
    "zip": "npm run build && node src/zip.js"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "hashery": "^3.0.1",
    "pbf": "^5.1.2",
    "pretty-bytes": "^7.1.1",
    "pretty-ms": "^9.3.0",
    "vanilla-jsoneditor": "^3.13.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.2",
    "gulp": "^5.0.1",
    "gulp-zip": "^6.1.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "volta": {
    "node": "25.7.0",
    "npm": "11.11.0"
  }
}
